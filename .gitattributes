# Everything is LF in the repo and in the working tree (the Docker build
# image is Linux; bash chokes on CRLF). Also silences git's per-file
# "LF will be replaced by CRLF" warning under core.autocrlf=true.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
