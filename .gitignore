# Exclude .claude contents but allow project skills/agents/rules/hooks
# and settings.json to be versioned (AIWF agent-workflow roster).
# Must use .claude/* (not .claude/) so git descends and honours negations.
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/agents/
!.claude/agents/**
!.claude/rules/
!.claude/rules/**
!.claude/hooks/
!.claude/hooks/**
.claude/skills/*-workspace/
environments.yml
