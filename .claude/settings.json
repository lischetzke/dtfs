{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard-git.sh" },
          { "type": "command", "command": "bash .claude/hooks/check-release-case.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/rustfmt-check.sh" }
        ]
      }
    ]
  }
}
