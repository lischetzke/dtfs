[Unit]
Description=DTFS FUSE Mount (/%I)
Documentation=https://github.com/lischetzke/dtfs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Instantiate with a systemd-escaped absolute path, e.g.
#   systemctl start dtfs-fuse@$(systemd-escape --path /mnt/dtfs).service
# %I decodes the escape back to "mnt/dtfs"; we prefix "/" to restore the absolute path.
#
# Bug H — when dtfs-fuse exits unexpectedly (OOM, panic, kernel signal)
# the mountpoint is left in the "Transport endpoint is not connected"
# state. systemd's Restart=on-failure relaunches the binary, but the
# subsequent mount(2) fails because the inode still references the
# dead session. ExecStartPre clears any such stale mount; the `-` means
# "ignore failure" so the first-ever launch (no stale mount) also works.
#
# Bug BQ-2 — use the absolute /usr/bin/fusermount3. The client image does
# not have the /bin -> /usr/bin usr-merge symlink, so /bin/fusermount3
# returned status=203/EXEC ("No such file or directory") on stop/restart,
# leaving the mount in a half-dead state. fuse3 installs the helper at
# /usr/bin/fusermount3.
ExecStartPre=-/usr/bin/fusermount3 -u /%I
ExecStart=/usr/local/bin/dtfs-fuse --config /etc/dtfs/fuse.toml --mountpoint /%I
# Bug U — on `systemctl stop` we deliver SIGTERM, which our signal handler
# uses to drive a clean MountHandle::unmount() (lets the kernel flush
# every open handle via FUSE flush+release ops) and release this PID's
# write leases on the manager. The fusermount3 -u on ExecStop is the
# fallback in case our handler hung up; it forces the kernel-level
# unmount regardless.
ExecStop=/usr/bin/fusermount3 -u /%I
Restart=on-failure
RestartSec=5
TimeoutStopSec=45s
KillSignal=SIGTERM
SendSIGKILL=yes
LimitNOFILE=65535

# Bug V — cooperative memory budget for composite hosts. The FUSE client
# holds writebuf segments (≤ chunk_size_mb per open writer), readahead
# pages, and the local-cache index. 1 GB is a sane default for a Plex
# client. Drop-in to enable:
#   /etc/systemd/system/dtfs-fuse@.service.d/memory.conf
#     [Service]
#     MemoryHigh=800M
#     MemoryMax=1024M

# FUSE requires CAP_SYS_ADMIN.
AmbientCapabilities=CAP_SYS_ADMIN

# Do NOT use PrivateTmp=yes here: it puts the unit in its own mount namespace,
# which hides the FUSE mount from the host. MountFlags=shared propagates any
# mounts performed by the service back to the host mount table.
MountFlags=shared

# Environment
Environment=RUST_LOG=dtfs=info

[Install]
WantedBy=multi-user.target
