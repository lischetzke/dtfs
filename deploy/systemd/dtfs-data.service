[Unit]
Description=DTFS Data Node
Documentation=https://github.com/leduc/dtfs2
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=dtfs
Group=dtfs
ExecStart=/usr/local/bin/dtfs-data --config /etc/dtfs/data.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Bug U — graceful shutdown window. On `systemctl stop` we SIGTERM the
# process; the dtfs-data signal handler then drains the in-flight write
# semaphore (up to 30s) before exiting. Give systemd 45s of slack on top
# so a chunk write to a slow USB disk doesn't get SIGKILL'd. After the
# timeout systemd does send SIGKILL — that's the safety valve.
TimeoutStopSec=45s
KillSignal=SIGTERM
SendSIGKILL=yes

# Bug G/V — cooperative memory budget. cgroup v2 MemoryHigh asks the
# kernel to reclaim pages cooperatively (slow down the process to give
# it time to free RAM) before MemoryMax hard-caps and risks OOM. The
# operator should set MemoryHigh = 90% of MemoryMax = data.toml's
# hard_cap_mb. Operators can override via a drop-in:
#   /etc/systemd/system/dtfs-data.service.d/memory.conf
# Default unset — composite-host operators must opt in.
# Example for a 2 GB data role on toro-plex:
#   [Service]
#   MemoryHigh=1800M
#   MemoryMax=2048M

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dtfs/data
PrivateTmp=yes

# Allow access to configured disk mount paths
# Add ReadWritePaths= for each managed disk, e.g.:
# ReadWritePaths=/mnt/ssd-a /mnt/ssd-b /mnt/hdd-a /mnt/hdd-b

# Environment — P1-11: tonic/openraft chatter suppressed at info-default.
Environment=RUST_LOG=dtfs=info,tonic=warn,h2=warn

# P1-11: cap per-service journal usage; relevant during multi-day soaks.
LogRateLimitIntervalSec=10
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target
