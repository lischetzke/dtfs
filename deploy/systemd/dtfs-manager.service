[Unit]
Description=DTFS Manager Node
Documentation=https://github.com/leduc/dtfs2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtfs
Group=dtfs
ExecStart=/usr/local/bin/dtfs-manager --config /etc/dtfs/manager.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dtfs/manager
PrivateTmp=yes

# Environment — P1-11: keep openraft/tonic quiet so 48h soaks don't fill
# /var/log/journal at debug. Override with `systemctl set-environment` for
# focused debugging.
Environment=RUST_LOG=dtfs=info,openraft=warn,tonic=warn,h2=warn

# P1-11: cap per-service journal usage so a chatty bug can't fill disk.
LogRateLimitIntervalSec=10
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target
