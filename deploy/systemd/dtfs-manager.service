[Unit]
Description=DTFS Manager Node
Documentation=https://github.com/lischetzke/dtfs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dtfs
Group=dtfs
ExecStart=/usr/local/bin/dtfs-manager --config /etc/dtfs/manager.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Bug U — graceful shutdown window. SIGTERM triggers a final Raft snapshot
# (≤5s budget) + a clean audit-log "manager.stop" event. 20s of slack
# above the snapshot timeout lets in-flight gRPC RPCs complete.
TimeoutStopSec=30s
KillSignal=SIGTERM
SendSIGKILL=yes

# Bug V — cooperative memory budget for composite hosts (e.g. toro-plex
# runs mgr + data + client + Plex). The manager's working set is small
# (audit ring, Raft state machine, scheduler queues); a 512 MB cap is
# typical. Drop-in to enable:
#   /etc/systemd/system/dtfs-manager.service.d/memory.conf
#     [Service]
#     MemoryHigh=400M
#     MemoryMax=512M

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dtfs/manager /etc/dtfs
PrivateTmp=yes

# Environment — P1-11: keep openraft/tonic quiet so 48h soaks don't fill
# /var/log/journal at debug. Override with `systemctl set-environment` for
# focused debugging.
Environment=RUST_LOG=dtfs=info,openraft=warn,tonic=warn,h2=warn

# P1-11: cap per-service journal usage so a chatty bug can't fill disk.
LogRateLimitIntervalSec=10
LogRateLimitBurst=2000

[Install]
WantedBy=multi-user.target
