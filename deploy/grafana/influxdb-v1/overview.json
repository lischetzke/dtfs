    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "DTFS overview",
  "uid": "dtfs-overview-v1",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Managers",
      "description": "Managers that pushed a point in the last minute; expect your configured manager count (3). Red means no manager reports.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT count(\"n\") AS \"managers\" FROM (SELECT last(\"value\") AS \"n\" FROM \"dtfs_raft_is_leader\" WHERE time > now() - 1m AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "managers"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Data nodes",
      "description": "Data nodes that pushed a point in the last minute. Fewer than deployed means a node is down or cannot push metrics.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT count(\"n\") AS \"data nodes\" FROM (SELECT last(\"value\") AS \"n\" FROM \"dtfs_data_mem_rss_bytes\" WHERE time > now() - 1m AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "data nodes"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "FUSE clients",
      "description": "FUSE clients that pushed a point in the last minute. Fewer than mounted means a client is down or cannot push metrics.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT count(\"n\") AS \"fuse clients\" FROM (SELECT last(\"value\") AS \"n\" FROM \"dtfs_fuse_meta_cache_entries\" WHERE time > now() - 1m AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "fuse clients"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Leader changes",
      "description": "Raft leader changes over the selected range (highest count seen by any manager). 0 is normal; repeated changes mean flapping.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"c\") AS \"leader changes\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_raft_leader_changes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "leader changes"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Disks failed",
      "description": "Data disks currently flagged failed. Any value of 1 or more needs attention.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"f\") AS \"failed disks\" FROM (SELECT last(\"value\") AS \"f\" FROM \"dtfs_data_disk_failed\" WHERE time > now() - 5m AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\", \"tier\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "failed disks"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Dropped batches",
      "description": "Metrics batches dropped from a full push queue over the selected range. Non-zero means the metrics path is lossy, so other panels may have gaps.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"dropped batches\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_metrics_dropped_batches\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"server\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "dropped batches"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Integrity events",
      "description": "Over the selected range: data node reads that failed verification, client BLAKE3 mismatches, chunks quarantined and scrub-found corrupt chunks. Anything above 0 is a data-integrity incident.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"data loss\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_data_get_data_loss_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\", \"tier\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "data loss"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"client mismatch\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_fuse_read_verify_failures\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "client mismatch"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "C",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"quarantined\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_data_quarantines_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\", \"tier\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "quarantined"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "D",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"scrub corrupt\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_data_scrub_corrupt_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\", \"tier\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "scrub corrupt"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "FUSE op errors",
      "description": "Failed FUSE operations over the selected range. 0 is normal; open the read-path dashboard for the split. ENOENT and EEXIST are left out: a lookup of a missing name or a create of an existing one is a normal answer, not a failure (the errno panels show them).",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"op errors\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_fuse_op_errors\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ AND \"errno\" !~ /^(ENOENT|EEXIST)$/ GROUP BY \"node\", \"op\", \"errno\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "op errors"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Commit and put rejects",
      "description": "Over the selected range: allocations and commits the managers rejected, and puts the data nodes rejected. Any value above 0 means writes were refused (replica floor, memory shed or auth).",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"alloc rejects\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_write_alloc_rejects\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"reason\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "alloc rejects"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"commit rejects\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_write_commit_rejects\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"reason\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "commit rejects"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "C",
          "hide": false,
          "query": "SELECT sum(\"c\") AS \"put rejects\" FROM (SELECT spread(\"value\") AS \"c\" FROM \"dtfs_data_put_rejects_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"method\", \"code\")",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "put rejects"
        }
      ]
    },
    {
      "id": 11,
      "type": "state-timeline",
      "title": "Raft leader per manager",
      "description": "Which manager is Raft leader over time: exactly one manager should show leader at any moment. A stretch with none means no quorum.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "leader",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "follower",
                  "color": "blue",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"v\" FROM \"dtfs_raft_is_leader\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "leader $tag_node"
        }
      ]
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Memory pressure per node",
      "description": "Memory ladder level of each manager and data node: normal, warn (caches shrinking) or shed (rejecting work). Anything but green needs a look at memory-health.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "normal",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "warn",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "shed",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "left",
        "rowHeight": 0.9,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"v\" FROM \"dtfs_memory_pressure_level\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "manager $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"v\" FROM \"dtfs_data_mem_pressure_level\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "data $tag_node"
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Throughput and latency",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Cluster throughput (FUSE)",
      "description": "Chunk bytes per second moved by all FUSE clients: write is PutChunk, read is GetChunk, summed across clients. Includes every replica copy a client sends.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"r\") AS \"write\" FROM (SELECT non_negative_derivative(last(\"value\"), 1s) AS \"r\" FROM \"dtfs_fuse_put_chunk_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\", \"tier\", \"src_dc\") GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT sum(\"r\") AS \"read\" FROM (SELECT non_negative_derivative(last(\"value\"), 1s) AS \"r\" FROM \"dtfs_fuse_get_chunk_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\", \"tier\", \"src_dc\") GROUP BY time($__interval) fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Data node throughput",
      "description": "Bytes per second stored (put) and served (get) per data node, summed over its disks. Shows where load lands.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"r\") AS \"put\" FROM (SELECT non_negative_derivative(last(\"value\"), 1s) AS \"r\" FROM \"dtfs_data_put_bytes_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\", \"disk\", \"tier\") GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT sum(\"r\") AS \"get\" FROM (SELECT non_negative_derivative(last(\"value\"), 1s) AS \"r\" FROM \"dtfs_data_get_bytes_total\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\", \"disk\", \"tier\") GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col $tag_node"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "FUSE read and write p99",
      "description": "99th percentile latency of FUSE read and write calls per client (per push interval, coarse). Sustained rises mean slow replicas or a saturated link.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"p99\") AS \"p99\" FROM \"dtfs_fuse_op_us\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ AND \"op\" =~ /^(read|write)$/ GROUP BY time($__interval), \"node\", \"op\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$col $tag_op $tag_node"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Raft write p99 per manager",
      "description": "99th percentile of a Raft client write (proposal to applied) and of the Raft log append plus fsync, per manager. Log write dominating means a slow log disk.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "µs",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"p99\") AS \"v\" FROM \"dtfs_raft_client_write_us\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "client write $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT max(\"p99\") AS \"v\" FROM \"dtfs_raft_log_write_us\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "log write $tag_node"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "Capacity and resources",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 33
      }
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Disk used",
      "description": "Used and total bytes of each data disk, one bar pair per disk (InfluxQL cannot divide two measurements; the InfluxDB v2 dashboard shows used over total with 80/90 percent thresholds). A used bar close to its total bar is a filling disk.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"used\" FROM \"dtfs_data_disk_used_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "used $tag_node $tag_disk"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"total\" FROM \"dtfs_data_disk_total_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"disk\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "total $tag_node $tag_disk"
        }
      ]
    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "RSS vs budget",
      "description": "Resident memory and hard cap of each manager and data node (last value). RSS close to its cap means memory pressure; cap 0 means no hard_cap_mb is configured. FUSE clients export no RSS gauge.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"rss\" FROM \"dtfs_memory_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "rss $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"cap\" FROM \"dtfs_memory_hard_cap_bytes\" WHERE $timeFilter AND \"value\" > 0 AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cap $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "C",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"rss\" FROM \"dtfs_data_mem_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "rss $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "D",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"cap\" FROM \"dtfs_data_mem_cap_bytes\" WHERE $timeFilter AND \"value\" > 0 AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cap $tag_node"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Raft follower lag (max)",
      "description": "Log entries each follower is behind the leader, per peer (the leader exports it, other managers report 0). Should hover near 0; a growing line means a slow or partitioned follower.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"lag\" FROM \"dtfs_raft_follower_lag\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"peer\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "lag $tag_peer"
