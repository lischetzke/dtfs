{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "type": "dashboards",
      "title": "DTFS dashboards",
      "tags": [
        "dtfs",
        "influxdb-v1"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Memory pressure level per node",
      "description": "Pressure level of each manager and data node: green normal, yellow warn (caches shrink), red shed (puts refused). Anything not green for long needs attention.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "normal",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "warn",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "shed",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          },
          "custom": {
            "fillOpacity": 70,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.9,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"x\" FROM \"dtfs_memory_pressure_level\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "manager $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT max(\"value\") AS \"x\" FROM \"dtfs_data_mem_pressure_level\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "data $tag_node"
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "RSS per node (latest)",
      "description": "Latest resident memory of each manager and data node. Compare with the cap and thresholds in the Memory section; the percent-of-budget ratio needs a join across measurements that InfluxQL cannot express.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "continuous-GrYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"x\" FROM \"dtfs_memory_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "manager $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT last(\"value\") AS \"x\" FROM \"dtfs_data_mem_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "data $tag_node"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dropped metrics batches (range)",
      "description": "Metrics batches dropped from a full push queue over the selected range, all nodes and servers. 0 is normal; any drop means points were lost, see the Metrics pipeline section.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"s\") AS \"x\" FROM (SELECT spread(\"value\") AS \"s\" FROM \"dtfs_metrics_dropped_batches\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"server\") WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "dropped"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Proxy rejected batches (range)",
      "description": "PushMetrics batches a manager refused over the selected range (auth, no servers, bad encoding, too large, bad line). 0 is normal; any rejection means proxy-mode nodes are losing metrics.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT sum(\"s\") AS \"x\" FROM (SELECT spread(\"value\") AS \"s\" FROM \"dtfs_metrics_proxy_rejected\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY \"node\", \"reason\") WHERE $timeFilter",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "rejected"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Manager RSS vs cap, warn and shed thresholds",
      "description": "Resident memory of each manager against its hard cap and the warn and shed thresholds. RSS should stay below warn; crossing shed makes the manager refuse new work.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_memory_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "rss $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_memory_hard_cap_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "hard cap $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "C",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_memory_warn_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "warn $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "D",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_memory_shed_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "shed $tag_node"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Data node RSS vs cap",
      "description": "Resident memory of each data node against its memory cap. Steady growth towards the cap means the node will start shedding puts.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_data_mem_rss_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "rss $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_data_mem_cap_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cap $tag_node"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Caches and backpressure",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "FUSE readahead cache vs budget",
      "description": "Bytes held in the FUSE readahead cache against its budget. Sitting at the budget is normal while streaming; the budget shrinking means memory pressure.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": 30000
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_fuse_readahead_cache_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "cache $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_fuse_readahead_budget_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "budget $tag_node"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "FUSE disk cache vs max",
      "description": "FUSE on-disk cache size against its configured maximum. Staying at max is normal for a busy cache.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
