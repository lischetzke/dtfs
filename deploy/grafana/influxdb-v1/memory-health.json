          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "A",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_fuse_disk_cache_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "disk cache $tag_node"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "${DS}"
          },
          "refId": "B",
          "hide": false,
          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_fuse_disk_cache_max_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "max $tag_node"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "FUSE write buffer vs dirty cap",
      "description": "Buffered unwritten bytes against the dirty cap. Reaching the cap blocks writers (see write cap waits).",
      "datasource": {
