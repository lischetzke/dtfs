          "query": "SELECT mean(\"value\") AS \"x\" FROM \"dtfs_fuse_write_buffered_bytes\" WHERE $timeFilter AND \"dc\" =~ /^$dc$/ AND \"role\" =~ /^$role$/ AND \"node\" =~ /^$node$/ GROUP BY time($__interval), \"node\" fill(null)",
          "rawQuery": true,
