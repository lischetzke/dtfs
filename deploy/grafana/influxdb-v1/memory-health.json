    {
      "id": 14,
      "type": "timeseries",
      "title": "FUSE write cap waits per second",
      "description": "How often writers blocked at the dirty cap, per second. Non-zero means writes are limited by upload speed or the cap.",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS}"
      },
      "interval": "10s",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
