# DTFS Data Node - Multi-stage build
# rustc must be new enough for Cargo.lock (time crate needs >= 1.88).
FROM rust:1.88-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang libclang-dev cmake protobuf-compiler pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
COPY proto/ proto/

RUN cargo build --release --bin dtfs-data

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        xfsprogs \
    && rm -rf /var/lib/apt/lists/* && \
    useradd --system --create-home --shell /bin/false dtfs

COPY --from=builder /build/target/release/dtfs-data /usr/local/bin/dtfs-data

USER dtfs
WORKDIR /var/lib/dtfs/data

EXPOSE 9500

ENTRYPOINT ["dtfs-data"]
CMD ["--config", "/etc/dtfs/data.toml"]
