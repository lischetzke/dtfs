      {
        "name": "dc-b",
        "role": "warm-cache",
        "bandwidth_mbps": { "down": 800, "up": 400, "jitter_ms": 5 },
        "max_age_days": 90,
        "readahead": "folder-sequential",
        "notes": "Warm + 90-day cache only"
      },
      {
        "name": "dc-c",
        "role": "warm-only",
        "bandwidth_mbps": { "down": 1000, "up": 1000, "jitter_ms": 1 },
        "notes": "1G symmetric; no cache, fast burst path"
      }
    ]
  },
