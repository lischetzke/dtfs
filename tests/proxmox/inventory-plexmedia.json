    "host": "10.150.0.121",
    "node": "i-pve01",
    "api_base": "https://10.150.0.121:8006/api2/json",
    "bridge": "vmbr0",
    "subnet": "10.150.0.0/24",
    "gateway": "10.150.0.1",
    "dns": ["10.150.0.2", "10.150.0.3"],
    "storage_vm_disks": "pve01_ssd01",
    "storage_primary_1": "pve01_usb01",
    "storage_primary_2": "pve01_usb02",
    "storage_primary_3": "pve01_usb03",
    "storage_primary_4": "pve01_usb04",
    "storage_warm_toro": "pve01_ssd02",
