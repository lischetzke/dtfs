  "volume_defaults": {
    "name": "media",
    "chunk_size_mb": 64,
    "anchor_datacenter": "leli",
    "replication": { "hot": 0, "warm": 2, "cold": 1 },
    "write_safety": { "min_replicas_before_ack": 1, "write_timeout_secs": 60 },
    "_note": "anchor_datacenter=leli enforces P0-10: primary always has ≥1 cold copy. warm rf=2 spreads across TORO and NRB so Plex streams can fail over."
  },
  "plex": {
    "max_stream_mbps": 60,
    "streams_per_client": 5,
    "_note": "Real-world Plex peak: 5×60=300 Mbps. LELI's 40 Mbps uplink cannot saturate even one stream from outside — verifies that Plex viewers in LELI rely on the local data-primary01 copy. TORO at 400 Mbps can sustain 5 streams from anywhere. NRB at 1G has zero stream constraints."
  },
  "ram_budget": {
    "host_total_gb": 64,
    "host_reserved_gb": 6,
    "cluster_total_mb": 23552,
    "_note": "5 mgr × 1024 + data-primary 4096 + 2×warm × 3072 + 3 client × 1536-2048 + builder 8192 = ~26 GB allocated. Disable PVE balloon to avoid swap surprises."
  }
