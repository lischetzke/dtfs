  "topology": {
    "cluster_name": "Plexmedia",
    "datacenters": [
      {
        "name": "leli",
        "role": "anchor",
        "bandwidth_mbps": { "down": 40, "up": 40, "jitter_ms": 25 },
        "notes": "DSL-class anchor — holds at least one replica of every file. All quorum managers live here so the cluster can't form a partition that excludes LELI."
      },
      {
        "name": "toro",
        "role": "warm-cache-ssd",
        "bandwidth_mbps": { "down": 400, "up": 400, "jitter_ms": 5 },
        "max_age_days": 90,
        "readahead": "folder-sequential",
        "notes": "SSD warm + folder readahead for Plex client streams. Empty at bootstrap; promoted by reads_by_dc."
      },
      {
        "name": "nrb",
        "role": "ingest-warm",
        "bandwidth_mbps": { "down": 1000, "up": 1000, "jitter_ms": 1 },
        "notes": "1G symmetric. Fresh downloads land on HDD here; replicate to LELI per anchor invariant."
      }
    ]
  },
  "vms": [
    {
      "role": "builder",
      "vmid": 9001,
      "name": "dtfs-builder",
      "ip": "10.150.0.150",
      "cores": 4,
      "memory_mb": 8192,
      "os_disk_gb": 32,
      "extra_disks": [],
      "persistent_through_soak": true,
      "notes": "Existing builder VM; rebuilds happen here so soak iteration is fast."
