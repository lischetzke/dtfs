# {{ inventory_hostname }} data.toml — generated by Ansible
# Schema matches crates/dtfs-common/src/config.rs DataNodeConfig.

[node]
id = "auto"
hostname = "{{ inventory_hostname }}"
data_dir = "/var/lib/dtfs/data"

[location]
region = "lab"
datacenter = "{{ dtfs_location }}"
rack = "{{ 'rack-A' if dtfs_location == 'dc1' else 'rack-B' }}"
host = "{{ inventory_hostname }}"

[cluster]
manager_addr = "{{ hostvars['mgr-01'].ansible_host }}:9401"
shared_secret = "{{ dtfs_shared_secret }}"

[grpc]
listen_addr = "0.0.0.0:9500"

[tls]
mode = "off"

{% for disk in dtfs_disks %}
[[disks]]
path = "{{ disk.path }}"
tier = "{{ disk.tier }}"

{% endfor %}
[cache]
max_memory_mb = {{ dtfs_cache_size_mb | default(512) }}
policy = "arc"

[scrub]
quick_interval_hours = 6
deep_interval_hours = 168
max_io_percent = 10
