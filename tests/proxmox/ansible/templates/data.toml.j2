# {{ inventory_hostname }} data.toml — generated by Ansible
# Schema matches crates/dtfs-common/src/config.rs DataNodeConfig.

[node]
id = "auto"
hostname = "{{ inventory_hostname }}"
data_dir = "/var/lib/dtfs/data"

[location]
region = "lab"
datacenter = "{{ dtfs_dc | default(dtfs_location | default('dc-a')) }}"
rack = "{{ dtfs_rack | default('rack-default') }}"
host = "{{ inventory_hostname }}"

[cluster]
{# Use the first manager in the inventory group as the primary endpoint
   (Plexmedia: mgr01 in LELI; 3-DC: mgr-01 in dc-a). Falls back gracefully
   across inventories that name managers differently. #}
manager_addr = "{{ hostvars[groups['managers'][0]].ansible_host }}:9401"
manager_addrs = [
{% for mgr in groups['managers'] %}
  "{{ hostvars[mgr].ansible_host }}:9401",
{% endfor %}
]
shared_secret = "{{ dtfs_cluster_secret | default(dtfs_shared_secret | default('rotate-me')) }}"

[grpc]
listen_addr = "0.0.0.0:9500"

[tls]
mode = "off"

{% for disk in dtfs_disks %}
[[disks]]
path = "{{ disk.path }}"
tier = "{{ disk.tier }}"

{% endfor %}
[cache]
max_memory_mb = {{ dtfs_cache_size_mb | default(512) }}
policy = "arc"

[scrub]
quick_interval_hours = 6
deep_interval_hours = 168
max_io_percent = 10
