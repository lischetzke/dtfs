# {{ inventory_hostname }} manager.toml — generated by Ansible
# Schema matches crates/dtfs-common/src/config.rs ManagerConfig (NOT the legacy Ansible template).

[node]
id = "auto"
hostname = "{{ inventory_hostname }}"
data_dir = "/var/lib/dtfs/manager"

[location]
region = "lab"
datacenter = "{{ dtfs_dc | default(dtfs_location | default('dc-a')) }}"
rack = "{{ dtfs_rack | default('rack-default') }}"
host = "{{ inventory_hostname }}"

[cluster]
name = "{{ dtfs_cluster_name }}"
shared_secret = "{{ dtfs_cluster_secret | default(dtfs_shared_secret | default('rotate-me')) }}"
bootstrap = {{ 'true' if dtfs_is_bootstrap | default(false) else 'false' }}

# Raft initial voters — all managers with `dtfs_is_voter != false` are
# enumerated. Plexmedia uses this to keep the 3 LELI managers as voters
# and mgr04/mgr05 as non-voting observers (FINDINGS.md F-009 covers the
# multi-voter bootstrap requirement; observer support requires the
# manager binary to skip self-addition when `dtfs_is_voter == false`).
{% for mgr in groups['managers'] if hostvars[mgr].dtfs_is_voter | default(true) %}
[[cluster.initial_voters]]
hostname = "{{ mgr }}"
addr = "{{ hostvars[mgr].ansible_host }}:9401"

{% endfor %}

[raft]
listen_addr = "0.0.0.0:9400"

[grpc]
listen_addr = "0.0.0.0:9401"

[api]
listen_addr = "0.0.0.0:9402"

[tls]
mode = "off"

[defaults]
chunk_size_mb = 4

[defaults.write_safety]
min_replicas_before_ack = 2
write_timeout_secs = 30

[defaults.replication]
# hot=2 because DC-A has only 2 hot-tier data nodes (hot rf=3 infeasible).
hot = {{ dtfs_replication_hot | default(2) }}
warm = {{ dtfs_replication_warm | default(2) }}
cold = {{ dtfs_replication_cold | default(1) }}

[tiering]
enabled = true
hot_threshold_reads_per_hour = {{ dtfs_tiering_hot_reads_per_hour | default(5) }}
cold_threshold_days = {{ dtfs_tiering_cold_days | default(14) }}
frozen_threshold_days = {{ dtfs_tiering_frozen_days | default(90) }}
evaluation_interval_secs = {{ dtfs_tiering_eval_interval_secs | default(3600) }}
migration_bandwidth_limit_mbps = 200

[monitoring]
heartbeat_interval_secs = 5
suspect_after_missed = 3
down_after_missed = 6

# P1-8 alert webhooks. Per-soak, a file-sink endpoint at
# http://10.150.0.121:18081/alerts captures every fired event; the
# post-soak report counts events per kind.
[alerts]
{% for w in dtfs_alert_webhooks | default([]) %}
[[alerts.webhooks]]
url = "{{ w.url }}"
secret = "{{ w.secret }}"
kinds = {{ w.kinds | default([]) | to_json }}
dedup_secs = {{ w.dedup_secs | default(300) }}
{% endfor %}
