# {{ inventory_hostname }} fuse.toml — generated by Ansible
# Schema matches crates/dtfs-common/src/config.rs FuseConfig.

[client]
manager_addr = "{{ hostvars['mgr-01'].ansible_host }}:9401"

[location]
region = "lab"
datacenter = "{{ dtfs_location }}"
rack = "{{ 'rack-A' if dtfs_location == 'dc1' else 'rack-B' }}"
host = "{{ inventory_hostname }}"

[mount]
mountpoint = "{{ dtfs_mount_point }}"

[readahead]
enabled = true
min_kb = 128
max_mb = 32

[cache]
enabled = true
max_size_mb = 512
ttl_secs = 60

[partition_safety]
mode = "localreadonly"
quorum_loss_timeout_secs = 30
show_warning = true
