# {{ inventory_hostname }} fuse.toml — generated by Ansible
# Schema matches crates/dtfs-common/src/config.rs FuseConfig.

[client]
# P0-3: multi-manager failover. The client connects to manager_addr first;
# on transport errors it walks manager_addrs in order. The primary is the
# first manager in the inventory group (Plexmedia: mgr01 in LELI;
# 3-DC: mgr-01 in dc-a).
manager_addr = "{{ hostvars[groups['managers'][0]].ansible_host }}:9401"
manager_addrs = [
{% for mgr in groups['managers'] %}
  "{{ hostvars[mgr].ansible_host }}:9401",
{% endfor %}
]
# Bug AA — shared_secret enables client self-registration so this
# FUSE client appears in /api/v1/nodes with its full Location even
# when it never writes a file.
shared_secret = "{{ dtfs_cluster_secret | default(dtfs_shared_secret | default('rotate-me')) }}"

[location]
region = "lab"
datacenter = "{{ dtfs_dc | default(dtfs_location | default('dc-a')) }}"
rack = "{{ dtfs_rack | default('rack-default') }}"
host = "{{ inventory_hostname }}"

[mount]
mountpoint = "{{ dtfs_mount_point }}"
allow_other = true

[readahead]
mode = "{{ dtfs_readahead_mode | default('file-sequential') }}"
prefetch_chunks = 4
prefetch_next_files = 4

[cache]
{% if dtfs_cache_type | default('tmpfs') == 'disk' %}
local_cache_dir = "{{ dtfs_cache_dir | default('/var/cache/dtfs') }}"
local_cache_max_gb = {{ dtfs_cache_max_gb | default(10) }}
{% if dtfs_cache_max_age_days is defined and dtfs_cache_max_age_days %}
max_age_days = {{ dtfs_cache_max_age_days }}
{% endif %}
prune_interval_secs = 3600
{% else %}
# tmpfs/in-memory only — no disk cache configured
local_cache_max_gb = 0
prune_interval_secs = 3600
{% endif %}

[partition_safety]
mode = "localreadonly"
quorum_loss_timeout_secs = 30
show_warning = true

# Bug AV (AV-3-1) — write-path preference. "cold" (default) waits
# for the mandatory anchor copy before ACKing the write — safer
# but slower in DCs with slow uplinks to the anchor DC.
# "nearest-warm" places on the nearest warm-tier node and lets the
# manager schedule the anchor copy asynchronously (AV-3-3
# auto-anchor-migration). Unknown values fall back to "cold" so
# rolling upgrades stay safe.
[write]
first_write_tier = "{{ dtfs_first_write_tier | default('cold') }}"
