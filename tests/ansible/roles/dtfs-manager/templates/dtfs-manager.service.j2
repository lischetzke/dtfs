[Unit]
Description=DTFS Manager Node ({{ inventory_hostname }})
Documentation=https://github.com/leduc/dtfs2
After=network-online.target chrony.service
Wants=network-online.target

[Service]
# dtfs-manager does NOT call sd_notify, so Type=notify hangs systemd until
# WatchdogSec elapses. Use Type=simple to match the upstream
# deploy/systemd/dtfs-manager.service.
Type=simple
User={{ dtfs_user }}
Group={{ dtfs_group }}
ExecStart={{ dtfs_manager_bin }} --config {{ dtfs_config_dir }}/manager.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ dtfs_data_dir }} {{ dtfs_log_dir }} {{ dtfs_run_dir }} {{ dtfs_config_dir }}
PrivateTmp=yes

Environment="RUST_LOG={{ dtfs_log_level | default('info') }}"
Environment="RUST_BACKTRACE=1"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dtfs-manager

[Install]
WantedBy=multi-user.target
