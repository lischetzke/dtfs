# DTFS Manager Configuration — {{ inventory_hostname }}
# Schema matches crates/dtfs-common/src/config.rs::ManagerConfig

[node]
id = "auto"
hostname = "{{ inventory_hostname }}"
data_dir = "{{ dtfs_data_dir }}/manager"

[location]
region = "{{ dtfs_region | default('lab') }}"
datacenter = "{{ dtfs_location }}"
rack = "{{ dtfs_rack | default(dtfs_location ~ '-rack-default') }}"
host = "{{ inventory_hostname }}"

[cluster]
name = "{{ dtfs_cluster_name }}"
shared_secret = "{{ dtfs_shared_secret }}"
bootstrap = {{ 'true' if (dtfs_is_bootstrap | default(false)) else 'false' }}
{% if dtfs_is_bootstrap | default(false) %}
{% for h in groups['managers'] | sort %}
[[cluster.initial_voters]]
hostname = "{{ h }}"
addr = "{{ hostvars[h].ansible_host }}:{{ dtfs_grpc_port | default(9401) }}"
{% endfor %}
{% endif %}

[raft]
listen_addr = "0.0.0.0:{{ dtfs_raft_port | default(9400) }}"

[grpc]
listen_addr = "0.0.0.0:{{ dtfs_grpc_port | default(9401) }}"

[api]
listen_addr = "0.0.0.0:{{ dtfs_api_port | default(9402) }}"

[tls]
mode = "{{ dtfs_tls_mode | default('off') }}"

[defaults]
chunk_size_mb = {{ dtfs_chunk_size_mb | default(4) }}

[defaults.write_safety]
min_replicas_before_ack = {{ dtfs_replication_min_ack | default(2) }}
write_timeout_secs = {{ dtfs_write_timeout_secs | default(30) }}

[defaults.replication]
hot = {{ dtfs_replication_hot_factor | default(3) }}
warm = {{ dtfs_replication_warm_factor | default(2) }}
cold = {{ dtfs_replication_cold_factor | default(1) }}

[tiering]
enabled = {{ dtfs_tiering_enabled | default(true) | lower }}
hot_threshold_reads_per_hour = {{ dtfs_tiering_hot_threshold_reads_per_hour | default(5) }}
cold_threshold_days = {{ dtfs_tiering_cold_threshold_days | default(14) }}
frozen_threshold_days = {{ dtfs_tiering_frozen_threshold_days | default(90) }}
evaluation_interval_secs = {{ dtfs_tiering_evaluation_interval_secs | default(3600) }}
migration_bandwidth_limit_mbps = {{ dtfs_tiering_migration_bandwidth_mbps | default(200) }}

[monitoring]
heartbeat_interval_secs = {{ dtfs_heartbeat_interval_secs | default(5) }}
suspect_after_missed = {{ dtfs_suspect_after_missed | default(3) }}
down_after_missed = {{ dtfs_down_after_missed | default(6) }}
