# DTFS Manager Configuration
# Node: {{ inventory_hostname }} (node_id={{ dtfs_node_id }})
# Managed by Ansible — do not edit manually

[node]
id = {{ dtfs_node_id }}
name = "{{ inventory_hostname }}"
cluster = "{{ dtfs_cluster_name }}"
location = "{{ dtfs_location }}"

[cluster]
shared_secret = "{{ dtfs_shared_secret }}"
peers = [
{% for mgr in dtfs_managers %}
{% if mgr.node_id != dtfs_node_id %}
  { node_id = {{ mgr.node_id }}, addr = "{{ mgr.host }}:{{ mgr.port }}" },
{% endif %}
{% endfor %}
]

[raft]
listen_addr = "{{ dtfs_raft_listen_addr }}:{{ dtfs_raft_port }}"
data_dir = "{{ dtfs_raft_data_dir }}"
election_timeout_min_ms = {{ dtfs_raft_election_timeout_min_ms }}
election_timeout_max_ms = {{ dtfs_raft_election_timeout_max_ms }}
heartbeat_interval_ms = {{ dtfs_raft_heartbeat_interval_ms }}
snapshot_threshold = {{ dtfs_raft_snapshot_threshold }}
snapshot_interval_s = {{ dtfs_raft_snapshot_interval_s }}
log_max_entries = {{ dtfs_raft_log_max_entries }}
leader_lease_duration_ms = {{ dtfs_leader_lease_duration_ms }}
leader_renew_deadline_ms = {{ dtfs_leader_renew_deadline_ms }}

[grpc]
listen_addr = "{{ dtfs_grpc_listen_addr }}:{{ dtfs_grpc_port }}"
max_message_size_bytes = {{ dtfs_grpc_max_message_size_mb | int * 1024 * 1024 }}
keepalive_time_s = {{ dtfs_grpc_keepalive_time_s }}
keepalive_timeout_s = {{ dtfs_grpc_keepalive_timeout_s }}
max_concurrent_streams = {{ dtfs_grpc_max_concurrent_streams }}

[api]
listen_addr = "{{ dtfs_api_listen_addr }}:{{ dtfs_api_port }}"
read_timeout_s = {{ dtfs_api_read_timeout_s }}
write_timeout_s = {{ dtfs_api_write_timeout_s }}
max_body_size_bytes = {{ dtfs_api_max_body_size_mb | int * 1024 * 1024 }}

[webui]
enabled = {{ dtfs_webui_enabled | lower }}
path = "{{ dtfs_webui_path }}"

[metadata]
dir = "{{ dtfs_metadata_dir }}"
sync_interval_s = {{ dtfs_metadata_sync_interval_s }}
checkpoint_interval_s = {{ dtfs_metadata_checkpoint_interval_s }}

[replication]
default_hot_factor = {{ dtfs_replication_hot_factor }}
default_cold_factor = {{ dtfs_replication_cold_factor }}
min_ack_replicas = {{ dtfs_replication_min_ack }}
placement_strategy = "{{ dtfs_replication_placement }}"
cross_dc = {{ dtfs_replication_cross_dc | lower }}
trigger_delay_s = {{ dtfs_node_dead_after_s }}

[chunks]
size_bytes = {{ dtfs_chunk_size_mb | int * 1024 * 1024 }}
checksum_algorithm = "{{ dtfs_chunk_checksum_algorithm }}"
placement_strategy = "{{ dtfs_chunk_placement_strategy }}"

[tiering]
enabled = {{ dtfs_tiering_enabled | lower }}
hot_threshold_accesses = {{ dtfs_tiering_hot_threshold_accesses }}
hot_window_hours = {{ dtfs_tiering_hot_window_hours }}
cold_after_hours = {{ dtfs_tiering_cold_after_hours }}
evaluation_interval_s = {{ dtfs_tiering_evaluation_interval_s }}
migration_bandwidth_mb = {{ dtfs_tiering_migration_bandwidth_mb }}

[health]
check_interval_s = {{ dtfs_health_check_interval_s }}
check_timeout_s = {{ dtfs_health_check_timeout_s }}
node_dead_after_s = {{ dtfs_node_dead_after_s }}
node_suspect_after_s = {{ dtfs_node_suspect_after_s }}

[scrub]
quick_interval_hours = {{ dtfs_scrub_quick_interval_hours }}
deep_interval_hours = {{ dtfs_scrub_deep_interval_hours }}
concurrency = {{ dtfs_scrub_concurrency }}
bandwidth_limit_mb = {{ dtfs_scrub_bandwidth_limit_mb }}

[audit]
enabled = {{ dtfs_audit_enabled | lower }}
dir = "{{ dtfs_audit_dir }}"
rotation_size_bytes = {{ dtfs_audit_rotation_size_mb | int * 1024 * 1024 }}
retention_days = {{ dtfs_audit_retention_days }}

[metrics]
enabled = {{ dtfs_metrics_enabled | lower }}
listen_addr = "0.0.0.0:{{ dtfs_manager_metrics_port }}"
path = "{{ dtfs_manager_metrics_path }}"

[tls]
enabled = {{ dtfs_tls_enabled | lower }}

[logging]
level = "{{ dtfs_log_level }}"
format = "{{ dtfs_log_format }}"
dir = "{{ dtfs_log_dir }}/manager"
