# chrony configuration managed by Ansible (dtfs-common role)
# Node: {{ inventory_hostname }}

{% for server in ntp_servers %}
pool {{ server }} iburst
{% endfor %}

# Record drift compensation
driftfile /var/lib/chrony/drift

# Allow step adjustment on startup (up to {{ chrony_makestep.split(' ')[0] }}s, {{ chrony_makestep.split(' ')[1] }} times)
makestep {{ chrony_makestep }}

# Sync hardware clock
{% if chrony_rtcsync %}
rtcsync
{% endif %}

# Log tracking, statistics and measurements
logdir /var/log/chrony
log tracking statistics measurements

# Enable kernel synchronization
maxdistance {{ chrony_max_distance }}

# Logging
logchange 0.5

# Specify directory for lock file
pidfile /run/chrony/chronyd.pid

# Disable commandkey (not needed)
# cmdallow 127.0.0.1
