[Unit]
Description=DTFS Data Node ({{ inventory_hostname }})
Documentation=https://github.com/leduc/dtfs2
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
# dtfs-data does NOT call sd_notify; Type=notify would hang. Use Type=simple
# to match deploy/systemd/dtfs-data.service.
Type=simple
User={{ dtfs_user }}
Group={{ dtfs_group }}
ExecStart={{ dtfs_data_bin }} --config {{ dtfs_config_dir }}/data.toml
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
LimitMEMLOCK=infinity

# Security hardening — must include every disk mount path as ReadWritePaths
# so the data node can actually write under ProtectSystem=strict.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ dtfs_data_dir }} {{ dtfs_log_dir }}
{% for disk in dtfs_disks | default([]) %}
ReadWritePaths={{ disk.path }}
{% endfor %}
PrivateTmp=yes

Environment="RUST_LOG={{ dtfs_log_level | default('info') }}"
Environment="RUST_BACKTRACE=1"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=dtfs-data

[Install]
WantedBy=multi-user.target
