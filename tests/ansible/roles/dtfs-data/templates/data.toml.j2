# DTFS Data Node Configuration — {{ inventory_hostname }}
# Schema matches crates/dtfs-common/src/config.rs::DataNodeConfig

[node]
id = "auto"
hostname = "{{ inventory_hostname }}"
data_dir = "{{ dtfs_data_dir }}/data"

[location]
region = "{{ dtfs_region | default('lab') }}"
datacenter = "{{ dtfs_location }}"
rack = "{{ dtfs_rack | default(dtfs_location ~ '-rack-default') }}"
host = "{{ inventory_hostname }}"

[cluster]
# Primary manager + fallback list (F-024). If the primary is restarted or
# isolated, the data node walks through `manager_addrs` to find another
# manager and re-register, instead of hanging on a stale gRPC connection.
manager_addr = "{{ hostvars['mgr-01'].ansible_host }}:{{ dtfs_grpc_port | default(9401) }}"
manager_addrs = [
{% for h in groups['managers'] %}
    "{{ hostvars[h].ansible_host }}:{{ dtfs_grpc_port | default(9401) }}",
{% endfor %}
]
shared_secret = "{{ dtfs_shared_secret }}"

[grpc]
listen_addr = "0.0.0.0:{{ dtfs_data_grpc_port | default(9500) }}"

[tls]
mode = "{{ dtfs_tls_mode | default('off') }}"

{% for disk in dtfs_disks | default([]) %}
[[disks]]
path = "{{ disk.path }}"
tier = "{{ disk.tier }}"

{% endfor %}
[cache]
max_memory_mb = {{ dtfs_cache_size_mb | default(512) }}
policy = "{{ dtfs_cache_eviction_policy | default('arc') }}"

[scrub]
quick_interval_hours = {{ dtfs_scrub_quick_interval_hours | default(24) }}
deep_interval_hours = {{ dtfs_scrub_deep_interval_hours | default(168) }}
max_io_percent = {{ dtfs_scrub_max_io_percent | default(10) }}
