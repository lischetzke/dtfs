# DTFS FUSE Client Configuration — {{ inventory_hostname }}
# Schema matches crates/dtfs-common/src/config.rs::FuseConfig

[client]
manager_addr = "{{ hostvars['mgr-01'].ansible_host }}:{{ dtfs_grpc_port | default(9401) }}"
# F-024 hardening: list all managers so the FUSE client can fall back when
# the primary is restarted or isolated.
manager_addrs = [
{% for h in groups['managers'] %}
    "{{ hostvars[h].ansible_host }}:{{ dtfs_grpc_port | default(9401) }}",
{% endfor %}
]

[location]
region = "{{ dtfs_region | default('lab') }}"
datacenter = "{{ dtfs_location }}"
rack = "{{ dtfs_rack | default(dtfs_location ~ '-rack-default') }}"
host = "{{ inventory_hostname }}"

[mount]
mountpoint = "{{ dtfs_mount_point }}"
allow_other = {{ dtfs_fuse_allow_other | default(true) | lower }}

[readahead]
enabled = {{ dtfs_readahead_enabled | default(true) | lower }}
min_kb = {{ dtfs_readahead_min_kb | default(128) }}
max_mb = {{ dtfs_readahead_max_mb | default(32) }}

[cache]
enabled = {{ dtfs_client_cache_enabled | default(true) | lower }}
max_size_mb = {{ dtfs_client_cache_size_mb | default(512) }}
ttl_secs = {{ dtfs_client_cache_ttl_s | default(60) }}

[partition_safety]
# Valid values: "strict", "localreadonly", "fulllock"
mode = "{{ dtfs_partition_safety | default('localreadonly') }}"
quorum_loss_timeout_secs = {{ dtfs_partition_quorum_loss_timeout_secs | default(30) }}
show_warning = {{ dtfs_partition_show_warning | default(true) | lower }}
