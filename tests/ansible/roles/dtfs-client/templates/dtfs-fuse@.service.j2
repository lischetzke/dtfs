[Unit]
Description=DTFS FUSE Mount (/%I)
Documentation=https://github.com/lischetzke/dtfs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
# Instantiate with a systemd-escaped absolute path, e.g.
#   systemctl start dtfs-fuse@$(systemd-escape --path {{ dtfs_mount_point }}).service
#
# Bug H — clear any stale mount left by a previous crashed instance so
# the new dtfs-fuse can re-mount. `-` ignores failure (first-ever launch
# has no stale mount).
ExecStartPre=-/usr/bin/fusermount3 -u /%I
ExecStart={{ dtfs_fuse_bin }} --config {{ dtfs_config_dir }}/fuse.toml --mountpoint /%I
ExecStop=/usr/bin/fusermount3 -u /%I
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

AmbientCapabilities=CAP_SYS_ADMIN

# Mount propagation back to host (without this the FUSE mount would be
# hidden in a private namespace and writes would silently land on local disk).
MountFlags=shared

Environment=RUST_LOG=dtfs={{ dtfs_log_level | default('info') }}
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
